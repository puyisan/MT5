;London Breakout v2.66 - backtest con las ENTRADAS de v2.65, para comparar ambas versiones
;Cambios sobre v2.66 por defecto: CompensarSpreadBuy=false, TrailingPasoPips=0, ModoDSTBroker=1 (EUROPA), TelegramEnabled=false
;Los arreglos de rango, lotes, gestion tras la ventana, etc. siguen activos: no dara exactamente lo mismo que v2.65
;Probador: cuenta HEDGING | modelo "Cada tick basado en ticks reales" | simbolo US30 del broker
;ModoDSTBroker: 1=EUROPA (por defecto aqui), 2=EEUU si tu broker cambia de hora con EE.UU. (0=AUTO en el probador = EUROPA)
;PuntosPerPip=100 asume _Point=0.01 (1 pip = 1 punto del indice). Comprueba 'pipSize' en el diario al arrancar
;Los inputs visuales (niveles, rango, lineas, dashboard) no se incluyen: quedan con sus valores por defecto
RiskPerBala=0.5
MaxDailyLossPct=2.0
MaxDailyProfitPct=3.0
ReservaDeslizamientoPct=0.0
LoteMinBroker=0.01
ValorPuntoPorLote=1.0
PuntosPerPip=100
StopLossPips=50.0
TP1Pips=100.0
TP2Pips=200.0
OffsetEntradaPips=1.0
CompensarSpreadBuy=false
MaxSpreadPips=0.0
CP1Pips=50.0
BEOffsetPips=0.0
CP3Pips=150.0
CP3_TrailingPips=50.0
TrailingPasoPips=0.0
UseTrailingCP3=true
RemoveTP2atCP4=false
UsarConfirmacion=true
VelasConfirmacion=1
TradeMonday=true
TradeTuesday=true
TradeWednesday=true
TradeThursday=true
TradeFriday=true
VentanaViernesPips=3
FiltrarFestivosUS=true
FiltrarFestivosUK=true
MagicNumber=80082505
TradeComment=RRL_US30
UsarDSTAutomatico=true
GMT_Broker_Base=2
ModoDSTBroker=1
CierreViernesBroker=22
GMT_Broker_Manual=2
GMT_Londres_Manual=0
GMT_NY_Manual=-5
GMT_LondresAbre=8
GMT_NYAbre=14
GMT_VentanaCierra=18
